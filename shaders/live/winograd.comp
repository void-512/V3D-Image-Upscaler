#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x=16,local_size_y=12) in;
layout(set=0,binding=0,std430) readonly buffer Input {float a[];};
#if OP == 1
layout(set=0,binding=2,std430) buffer Output {vec4 o4[];};
#else
layout(set=0,binding=2,std430) buffer Output {float o[];};
#endif
layout(set=0,binding=3,std430) readonly buffer Weights {float w[];};
layout(set=0,binding=4,std430) readonly buffer Residual {float d[];};
layout(set=0,binding=5,std430) readonly buffer OuterResidual {float e[];};
layout(set=0,binding=6,std430) readonly buffer Input4 {vec4 a4[];};
layout(set=0,binding=7,std430) readonly buffer Weight4 {vec4 w4[];};
layout(push_constant,std430) uniform Params {int p[24];};
layout(constant_id=0) const int H=16;
layout(constant_id=1) const int W=16;
layout(constant_id=2) const int IC=64;
layout(constant_id=3) const int OC=32;
layout(constant_id=7) const int MODE=0;
layout(constant_id=8) const int STRIDE=64;
layout(constant_id=9) const int OSTRIDE=32;
layout(constant_id=10) const int OFFSET=0;
layout(constant_id=11) const int ADD=0;
layout(constant_id=12) const int T=64;
layout(constant_id=13) const int TW=8;
layout(constant_id=14) const int FIRST=0;
layout(constant_id=15) const int COUNT=64;
layout(constant_id=21) const int WPACKED=0;

#ifdef ANIME
#define WINSTRIDE IC
#else
#define WINSTRIDE 192
#endif

void main(){
#if OP == 0
    int i=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*192+gl_LocalInvocationIndex);
    if(i>=T*COUNT)return;
    int tile=i/COUNT,c=FIRST+i%COUNT;
#ifdef ANIME
    int imageTile=tile+p[16];
#else
    int imageTile=tile;
#endif
    int yy=imageTile/TW*4-1,xx=imageTile%TW*4-1;
    float v[36];
    for(int y=0;y<6;y++) {
        float r[6];
        for(int x=0;x<6;x++){ float z=a[(clamp(yy+y,0,H-1)*W+clamp(xx+x,0,W-1))*STRIDE+c]; r[x]=(yy+y>=0&&yy+y<H&&xx+x>=0&&xx+x<W)?z:0.; }
        v[y*6+0]=4.*r[0]-5.*r[2]+r[4];
        v[y*6+1]=-4.*r[1]-4.*r[2]+r[3]+r[4];
        v[y*6+2]=4.*r[1]-4.*r[2]-r[3]+r[4];
        v[y*6+3]=-2.*r[1]-r[2]+2.*r[3]+r[4];
        v[y*6+4]=2.*r[1]-r[2]-2.*r[3]+r[4];
        v[y*6+5]=4.*r[1]-5.*r[3]+r[5];
    }
    for(int x=0;x<6;x++) {
        float r[6],q[6];
        for(int y=0;y<6;y++)r[y]=v[y*6+x];
        q[0]=4.*r[0]-5.*r[2]+r[4];
        q[1]=-4.*r[1]-4.*r[2]+r[3]+r[4];
        q[2]=4.*r[1]-4.*r[2]-r[3]+r[4];
        q[3]=-2.*r[1]-r[2]+2.*r[3]+r[4];
        q[4]=2.*r[1]-r[2]-2.*r[3]+r[4];
        q[5]=4.*r[1]-5.*r[3]+r[5];
        for(int y=0;y<6;y++)o[(((y*6+x)*T+tile/4*4)*WINSTRIDE+c*4)+tile%4]=q[y];
    }
#elif OP == 1
    uint lane=gl_SubgroupInvocationID,mi=lane>>2,ni=lane&3u;
    uint subgroup=gl_WorkGroupID.y*12u+gl_SubgroupID;
    uint row=(subgroup%uint((T+15)/16))*16u,col=gl_WorkGroupID.x*16u,plane=subgroup/uint((T+15)/16);
    // Each lane owns a 4x4 output block. A and B start at the same K phase.
    // Compute locally once, then rotate both operands three times. The loads
    // are unchanged; FP32 summation order changes within each four-channel group.
    uint phase=(mi+ni)&3u;
    uint ai=(plane*uint(T/4)+min((row>>2)+mi,uint(T/4-1)))*uint(WINSTRIDE)+phase;
    uint cq=min((col>>2)+ni,uint(OC/4-1));
    uint bi=uint(p[5])/4u+(WPACKED!=0?(plane*uint(OC/4)+cq)*uint(IC)+phase:(plane*uint(IC)+phase)*uint(OC/4)+cq);
    uint bs=WPACKED!=0?4u:uint(OC);
    uint ar=mi*4u+((ni+1u)&3u),br=((mi+1u)&3u)*4u+ni;
    vec4 s0=vec4(0),s1=vec4(0),s2=vec4(0),s3=vec4(0);
    for(uint k=0u;k<uint(IC);k+=4u){
        vec4 av=a4[ai+k],bv=w4[bi+k/4u*bs];
        s0+=av.x*bv;s1+=av.y*bv;s2+=av.z*bv;s3+=av.w*bv;
        av=subgroupShuffle(av,ar);bv=subgroupShuffle(bv,br);
        s0+=av.x*bv;s1+=av.y*bv;s2+=av.z*bv;s3+=av.w*bv;
        av=subgroupShuffle(av,ar);bv=subgroupShuffle(bv,br);
        s0+=av.x*bv;s1+=av.y*bv;s2+=av.z*bv;s3+=av.w*bv;
        av=subgroupShuffle(av,ar);bv=subgroupShuffle(bv,br);
        s0+=av.x*bv;s1+=av.y*bv;s2+=av.z*bv;s3+=av.w*bv;
    }
    uint r=row+mi*4u,c=col+ni*4u;
    if(c<uint(OC)){
        if(r<uint(T))o4[((plane*uint(T)+r)*uint(OC)+c)/4u]=s0;
        if(r+1u<uint(T))o4[((plane*uint(T)+r+1u)*uint(OC)+c)/4u]=s1;
        if(r+2u<uint(T))o4[((plane*uint(T)+r+2u)*uint(OC)+c)/4u]=s2;
        if(r+3u<uint(T))o4[((plane*uint(T)+r+3u)*uint(OC)+c)/4u]=s3;
    }
#else
    int i=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*192+gl_LocalInvocationIndex);
    #ifdef ANIME
    int tiles=p[17];
#else
    int tiles=((H+3)/4)*TW;
#endif
    if(i>=tiles*OC)return;
    int tile=i/OC,c=i%OC;
#ifdef ANIME
    int imageTile=tile+p[16];
#else
    int imageTile=tile;
#endif
    int yy=imageTile/TW*4,xx=imageTile%TW*4;
    vec4 r[6];
    for(int y=0;y<6;y++) {
        float v[6];
        for(int x=0;x<6;x++)v[x]=a[((y*6+x)*T+tile)*OC+c];
        r[y]=vec4(v[0]+v[1]+v[2]+v[3]+v[4],v[1]-v[2]+2.*(v[3]-v[4]),v[1]+v[2]+4.*(v[3]+v[4]),v[1]-v[2]+8.*(v[3]-v[4])+v[5]);
    }
    vec4 result[4]=vec4[4](r[0]+r[1]+r[2]+r[3]+r[4],r[1]-r[2]+2.*(r[3]-r[4]),r[1]+r[2]+4.*(r[3]+r[4]),r[1]-r[2]+8.*(r[3]-r[4])+r[5]);
    for(int y=0;y<4;y++)for(int x=0;x<4;x++)if(yy+y<H&&xx+x<W){
        int row=(yy+y)*W+xx+x;
        float v=result[y][x]+w[p[6]+c];
        if(MODE==1)v=max(v,0.)+0.2*min(v,0.);
        if(MODE>=2)v*=0.2;
        if(ADD!=0)v+=d[row*(MODE>=2?192:OSTRIDE)+c];
        if(MODE==3)v=0.2*v+e[row*64+c];
        o[row*OSTRIDE+OFFSET+c]=v;
    }
#endif
}
