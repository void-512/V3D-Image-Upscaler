#version 450
layout(local_size_x=192) in;
layout(set=0,binding=0,std430) readonly buffer Input {float a[];};
layout(set=0,binding=2,std430) buffer Output {float o[];};
layout(push_constant,std430) uniform Params {int p[24];};
void main(){
    int i=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*192+gl_LocalInvocationID.x);
    if(i>=p[0]*p[1]*p[2]*p[2]*3)return;
    if(p[2]==4)o[i]=a[i];
    else if(p[2]==2) {int c=i%3,x=(i/3)%(p[1]*2),y=i/(p[1]*6),j=(y*2*p[1]*4+x*2)*3+c;
    o[i]=(a[j]+a[j+3]+a[j+p[1]*12]+a[j+p[1]*12+3])*0.25;}
    else {
        int c=i%3,x=(i/3)%p[1],y=i/(p[1]*3);
        float sum=0.;
        for(int dy=0;dy<4;dy++)for(int dx=0;dx<4;dx++)
            sum+=a[((y*4+dy)*p[1]*4+x*4+dx)*3+c];
        o[i]=sum*(1./16.);
    }
}
