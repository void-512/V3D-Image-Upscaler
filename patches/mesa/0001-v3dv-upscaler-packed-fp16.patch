+/* Fuse explicitly packed vector FP16 math before lowering the bitcasts. */
+static nir_scalar
+packed_fp16_src(nir_scalar value, unsigned src)
+{
+   return nir_scalar_chase_movs(nir_scalar_chase_alu_src(value, src));
+}
+
+static bool
+lower_packed_fp16(nir_builder *b, nir_alu_instr *pack, void *data)
+{
+   if (pack->op != nir_op_pack_32_2x16)
+      return false;
+
+   nir_alu_src *src = &pack->src[0];
+   nir_scalar lo = nir_scalar_resolved(src->src.ssa, src->swizzle[0]);
+   nir_scalar hi = nir_scalar_resolved(src->src.ssa, src->swizzle[1]);
+   if (lo.def != hi.def || lo.comp != 0 || hi.comp != 1 ||
+       !nir_scalar_is_alu(lo))
+      return false;
+
+   nir_op op = nir_scalar_alu_op(lo);
+   if (op != nir_op_fmul && op != nir_op_fadd)
+      return false;
+
+   nir_scalar words[2];
+   enum v3d_qpu_input_unpack unpack = V3D_QPU_UNPACK_NONE;
+   for (unsigned i = 0; i < ARRAY_SIZE(words); i++) {
+      nir_scalar a = packed_fp16_src(lo, i);
+      nir_scalar b = packed_fp16_src(hi, i);
+      if (!nir_scalar_is_alu(a) || nir_scalar_alu_op(a) != nir_op_unpack_32_2x16 ||
+          !nir_scalar_is_alu(b) || nir_scalar_alu_op(b) != nir_op_unpack_32_2x16)
+         return false;
+
+      words[i] = packed_fp16_src(a, 0);
+      if (!nir_scalar_equal(words[i], packed_fp16_src(b, 0)))
+         return false;
+
+      if (op == nir_op_fmul && i == 0 && a.comp == b.comp)
+         unpack = a.comp ? V3D_QPU_UNPACK_REPLICATE_H_16 : V3D_QPU_UNPACK_REPLICATE_L_16;
+      else if (a.comp != 0 || b.comp != 1)
+         return false;
+   }
+
+   b->cursor = nir_before_instr(&pack->instr);
+   nir_def *a = nir_channel(b, words[0].def, words[0].comp);
+   nir_def *c = nir_channel(b, words[1].def, words[1].comp);
+   nir_def *result = op == nir_op_fadd ? nir_fadd2x16_v3d(b, a, c) :
+                     nir_fmul2x16_v3d(b, a, c, .component = unpack);
+   nir_def_rewrite_uses(&pack->def, result);
+   return true;
+}
